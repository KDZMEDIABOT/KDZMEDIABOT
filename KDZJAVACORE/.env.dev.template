# Development environment template
# Copy this file to .env.dev and fill in your actual values

# Docker BuildKit (required for Docker Compose cache mounts)
DOCKER_BUILDKIT=1
COMPOSE_BAKE=true

# Database configuration
DB_URL=jdbc:postgresql://127.0.0.1:5432/aisystem_dev
DB_NAME=aisystem_dev
DB_USERNAME=aisystem_dev_user
DB_PASSWORD=your_secure_password

# SSO configuration
SSO_CLIENT_ID=your_dev_client_id
SSO_CLIENT_SECRET=your_dev_client_secret
SSO_ISSUER_URI=https://your-dev-idp.example.com/oauth2/default

# Server configuration
HTTPD_SERVER_PORT=8080
SERVER_PROFILE=dev
article_generation_jobs_pool_size=5

# AI API keys (placeholder)
CLAUDE_API_KEY=your_claude_api_key
OPENAI_API_KEY=your_openai_api_key

# Passport.js auth service
# AUTH SERVICE HTTPD server port (default 3001)
AUTH_SERVICE_HTTPD_PORT=3001

# Frontend URL (where to redirect after login/logout)
AUTH_SERVICE_FRONTEND_URL=http://localhost:9000

# Auth service public URL (for OIDC callback –
# must be reachable by IdP)
AUTH_SERVICE_PUBLIC_URL=http://localhost:3001

# Auth service session secret
# (use a long random string in production)
AUTH_SERVICE_SESSION_SECRET=your-session-secret

# Auth service session store
AUTH_SESSION_STORE=redis
AUTH_SERVICE_REDIS_URL=redis://redis:6379
AUTH_SERVICE_REDIS_PREFIX=aisystem:auth:sess:

# Reading Plus AI MCP sidecar
READINGPLUS_MCP_SERVER_VERSION=0.1.5
READINGPLUS_MCP_PROTOCOL_VERSION=1.1.0

# Deep research via ReadingPlus MCP
RESEARCH_DEEPRESEARCH_MCP_SERVER_NAME=readingplus-deepresearch
RESEARCH_DEEPRESEARCH_MCP_BEARER_TOKEN=
RESEARCH_DEEPRESEARCH_MAX_STEPS=8
RESEARCH_DEEPRESEARCH_DEFAULT_USER_ID=1
